<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aspire Hub — Weekly Class Schedule</title>
<style>
:root{font-family:system-ui,sans-serif;color:#203c33;background:#f3f6f2}*{box-sizing:border-box}body{margin:0}main{max-width:1500px;margin:auto;padding:36px 28px}h1{font-size:34px;margin:8px 0}h2{margin:0 0 8px}p{line-height:1.6}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:700;color:#547468}.muted{color:#61776e}.notice{background:#fff2d5;border-radius:10px;padding:14px 18px;font-size:14px}.panel{background:white;border:1px solid #dfe8e0;border-radius:14px;padding:24px;margin:24px 0}.filters{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr)) auto auto;gap:14px;align-items:end}label{display:flex;flex-direction:column;gap:8px;font-size:13px;font-weight:650}select,button{font:inherit;border:1px solid #bdcec3;border-radius:7px;padding:12px;background:white;min-height:46px;width:100%}button{cursor:pointer;font-weight:650}button.primary{background:#215b46;color:white;border-color:#215b46}button:hover{filter:brightness(.96)}button:focus-visible,select:focus-visible{outline:3px solid #cf9e36;outline-offset:3px}.help{font-size:13px;color:#61776e;margin:12px 0 0}#count{margin:24px 0 8px;font-weight:650}.branch-head{display:flex;justify-content:space-between;gap:20px;align-items:start;margin-bottom:18px}.contact{font-size:14px;text-align:right;line-height:1.8}a{color:#1b6549}.scroll{overflow:auto;border:1px solid #dbe5dd;border-radius:8px}table.week{border-collapse:separate;border-spacing:0;table-layout:fixed;width:100%;min-width:1000px;font-size:13px}.week thead th{position:sticky;top:0;background:#eaf1eb;z-index:2;text-align:center;padding:14px;border-bottom:1px solid #cfded3}.week th:first-child{width:170px}.week tbody th{background:#f3f7f3;text-align:left;padding:14px;font-size:13px;border-bottom:1px solid #dbe5dd;white-space:pre-line}.week td{vertical-align:top;border-right:1px solid #e0e9e2;border-bottom:1px solid #e0e9e2;padding:7px}.week .time{position:sticky;left:0;z-index:1;background:#f7faf7;text-align:center;font-weight:600;padding:15px 6px;white-space:nowrap}.class{background:#eff6f0;border-left:3px solid #3d8060;border-radius:6px;padding:10px;margin-bottom:7px;line-height:1.5}.class:last-child{margin-bottom:0}.class strong{display:block;color:#174b34}.class small{display:block;color:#536d5e;margin-top:4px}.badge{font-size:10px;background:#f9eac5;border-radius:4px;padding:2px 5px;color:#735611;display:inline-block;margin-top:5px}.empty{padding:22px;background:#f6f8f5;border-radius:8px}.unresolved{margin-top:18px;border-top:1px solid #dfe8e0;padding-top:16px}.review-list{font-size:13px;line-height:1.7;padding-left:22px}.details-table{border-collapse:collapse;width:100%;font-size:13px}.details-table td,.details-table th{padding:10px;border-bottom:1px solid #e0e9e2;text-align:left;vertical-align:top}.details-scroll{overflow:auto;max-height:500px}summary{cursor:pointer;font-weight:650}footer{font-size:13px;color:#61776e;padding:12px 0 30px}@media(max-width:950px){.filters{grid-template-columns:repeat(2,minmax(120px,1fr))}.branch-head{display:block}.contact{text-align:left;margin-top:10px}main{padding:24px 14px}.panel{padding:17px}h1{font-size:28px}}

/* Shared Business Planning appearance */
.embedded .schedule-header{display:none}.embedded main{padding:0}.embedded .schedule-tabs{margin-top:0}
:root{color:#233c38;background:#fff;font-size:14px}main{margin:0 auto;padding:24px;max-width:1500px}h1{font-size:26px;margin:0}.schedule-header p{margin:6px 0 20px}.schedule-tabs{display:flex;border-bottom:1px solid #dfe6e5;margin-bottom:24px}.schedule-tabs span{display:block;padding:12px 20px;background:#1e6f73;color:white;border-radius:7px 7px 0 0;font-weight:650}.panel{border-color:#cee0dc;border-radius:10px;margin:20px 0;padding:22px}.panel h2{font-size:20px;color:#174e48}.find-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(230px,1fr);gap:26px;margin-top:22px}fieldset{border:1px solid #d6e3dd;border-radius:8px;padding:16px;min-width:0}legend{padding:0 8px;font-size:13px;font-weight:700;color:#174e48}.course-fields>label{margin-bottom:24px}.zone-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.zone-group{padding:12px;background:#f5faf8;border:1px solid #e0ebe4;border-radius:7px}.zone-group h3{font-size:14px;color:#174e48;margin:0 0 10px}.check-line{display:flex;flex-direction:row;align-items:flex-start;gap:9px;font-size:13px;font-weight:400;padding:6px 0;cursor:pointer;line-height:1.5}.check-line input{width:16px;height:16px;min-height:0;margin:2px 0;accent-color:#1e6f73;flex-shrink:0}.all-choice{font-weight:650;padding-bottom:12px;margin-bottom:8px;border-bottom:1px solid #dce7e0}.zone-all{font-weight:650;font-size:12px}.find-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:24px;border-top:1px solid #dfe6e5;padding-top:18px}.find-actions button{width:auto;min-width:110px}.find-actions p{flex:1;min-width:200px}.primary{background:#1e6f73!important;border-color:#1e6f73!important}button:disabled{opacity:.45;cursor:not-allowed}.subject-field{max-height:420px;overflow:auto}.empty{background:#f4f8f6;border:1px dashed #cadbd3;color:#536d60}.week thead th{background:#e3f1f0}.class{background:#f0f7f4;border-left-color:#1e6f73}.class strong{color:#174e48}.branch-head h2{color:#174e48}@media(max-width:760px){.find-grid{grid-template-columns:1fr}.zone-grid{grid-template-columns:1fr 1fr}main{padding:16px}.find-actions p{flex-basis:100%}.subject-field{max-height:none}}@media(max-width:440px){.zone-grid{grid-template-columns:1fr}}
[hidden]{display:none!important}.schedule-tabs button{width:auto;border:0;border-radius:7px 7px 0 0;background:#edf4f2;color:#174e48}.schedule-tabs button[aria-current="page"]{background:#1e6f73;color:white}.edit-grid{display:grid;grid-template-columns:repeat(2,minmax(180px,1fr));gap:18px;margin:20px 0}.edit-grid input,.edit-grid textarea{font:inherit;padding:12px;border:1px solid #bdcec3;border-radius:7px;width:100%}.edit-grid fieldset{grid-column:1/-1}.edit-levels{display:flex;flex-wrap:wrap;gap:14px}.editor-actions{display:flex;gap:12px}.editor-actions button{width:auto}.members{margin-top:32px;border-top:1px solid #dfe6e5;padding-top:24px}@media(max-width:650px){.edit-grid{grid-template-columns:1fr}}
.schedule-tabs{gap:4px;flex-wrap:wrap}.saved-class{outline:2px solid #1e6f73;background:#e3f4ec}.created-week{margin-top:28px}.created-week .week th:first-child{width:auto}.schedule-tabs button{font-size:13px;padding:12px 16px}
</style></head><body><main>
<header class="schedule-header"><div><h1>Scheduling</h1><p class="muted">Aspire Hub · Term 1 2027</p></div></header>
<nav class="schedule-tabs" aria-label="Scheduling"><button id="find-tab" type="button" aria-current="page">Find A Class</button><button id="edit-tab" type="button">Edit A Class</button><button id="create-tab" type="button">Create Class</button><button id="members-tab" type="button" style="margin-left:auto">Member Access</button></nav>
<div id="find-screen"><section class="panel" aria-labelledby="filter-title"><h2 id="filter-title">Find A Class</h2><p class="help">Choose branches, one level and your subjects, then click Search.</p><form id="filters">
<div class="find-grid"><fieldset class="branch-field"><legend>1. Zone and branches</legend><div id="branch-controls"></div></fieldset>
<div class="course-fields"><label for="level">2. Level<select id="level" required><option value="">Select one level</option></select></label>
<fieldset class="subject-field"><legend>3. Subjects</legend><div id="subject-controls"><p class="help">Select a level to see its subjects.</p></div></fieldset></div></div>
<div class="find-actions"><button class="primary" id="search-button" type="submit" disabled>Search</button><button type="button" id="reset">Clear selections</button><p class="help" id="filter-help" aria-live="polite">Select at least one branch and one level.</p></div>
</form></section>
<div id="count" role="status" aria-live="polite"></div><div id="results"><p class="empty">Select your branches, level and subjects, then click Search to view class schedules.</p></div>

</div><section id="edit-screen" class="panel" hidden><h2>Edit A Class</h2><p id="edit-status" role="status" aria-live="polite">Sign in to AspireOne Connect to edit classes. Editors and Managers can update schedules for their assigned branches.</p><div id="editor-content"></div></section>
<section id="create-screen" class="panel" hidden><h2>Create Class</h2><p id="create-status" role="status" aria-live="polite">Sign in to AspireOne Connect to create classes.</p><div id="create-content"></div></section><section id="members-screen" class="panel" hidden><h2>Member Access</h2><p id="members-status" role="status" aria-live="polite">Sign in to manage schedule access.</p><div id="members-content"></div></section>
<footer>All times are Singapore time.</footer>
</main><script>
let data=DATA;let branches=BRANCHDATA;
const $=id=>document.getElementById(id),days=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const clock=n=>(Math.floor(n/60)%12||12)+(n%60?':'+String(n%60).padStart(2,'0'):'')+(n>=720?'pm':'am');
const subjectAliases=SUBJECTALIASES;
const subjectName=s=>subjectAliases[s]||s;
const subjects=r=>[subjectName(r[3])];
const levels=r=>JSON.parse(r[5]);

const selectedBranches=new Set(),selectedSubjects=new Set(),branchChecks=new Map(),zoneChecks=new Map(),subjectChecks=new Map();let allSubjects=true,allBranchBox,allSubjectBox;let hasSearched=false;
function levelName(code){if(/^P\d$/.test(code))return 'Primary '+code.slice(1);if(/^S\d$/.test(code))return 'Secondary '+code.slice(1);return code.replace('IPY','IP Year ').replace('IBY','IB Year ').replace(/^JC/,'JC ')}
function check(label,handler){const row=el('label',null,'check-line'),box=el('input');box.type='checkbox';box.addEventListener('change',()=>handler(box.checked));row.append(box,el('span',label));return [row,box]}
function pending(){$('filter-help').textContent=hasSearched?'Selections changed. Click Search to update the timetable.':'Choose your classes, then click Search.';updateSearch()}
function updateSearch(){$('search-button').disabled=!selectedBranches.size||!$('level').value||!selectedSubjects.size}
function syncBranchChecks(){for(const [id,box]of branchChecks)box.checked=selectedBranches.has(id);for(const [zone,box]of zoneChecks){const ids=branches.filter(b=>b[2]===zone).map(b=>b[0]),n=ids.filter(id=>selectedBranches.has(id)).length;box.checked=n===ids.length;box.indeterminate=n>0&&n<ids.length}allBranchBox.checked=selectedBranches.size===branches.length;allBranchBox.indeterminate=selectedBranches.size>0&&selectedBranches.size<branches.length}
function changedBranches(){syncBranchChecks();updateLevels();pending()}
function buildBranches(){const target=$('branch-controls');target.replaceChildren();branchChecks.clear();zoneChecks.clear();const [all,box]=check('All branches',on=>{selectedBranches.clear();if(on)branches.forEach(b=>selectedBranches.add(b[0]));changedBranches()});allBranchBox=box;all.className+=' all-choice';target.append(all);const grid=el('div',null,'zone-grid');for(const zone of ['Central','East','West','North East','North']){const section=el('section',null,'zone-group');section.append(el('h3',zone));const members=branches.filter(b=>b[2]===zone);const [row,zoneBox]=check('All branches in '+zone,on=>{for(const b of members){if(on)selectedBranches.add(b[0]);else selectedBranches.delete(b[0])}changedBranches()});zoneChecks.set(zone,zoneBox);row.className+=' zone-all';section.append(row);for(const b of members){const [row,branchBox]=check(b[1],on=>{if(on)selectedBranches.add(b[0]);else selectedBranches.delete(b[0]);changedBranches()});branchChecks.set(b[0],branchBox);section.append(row)}grid.append(section)}target.append(grid)}
function updateLevels(){const old=$('level').value;const selectedData=data.filter(r=>!selectedBranches.size||selectedBranches.has(r[1]));const catalogue=selectedData.length?selectedData:data;const rank=x=>/^P/.test(x)?0:/^S/.test(x)?1:/^IP/.test(x)?2:/^IB/.test(x)?3:4;const values=[...new Set(catalogue.flatMap(levels))].sort((a,b)=>rank(a)-rank(b)||a.localeCompare(b,undefined,{numeric:true}));$('level').replaceChildren(new Option('Select one level',''));for(const value of values)$('level').add(new Option(levelName(value),value));if(values.includes(old))$('level').value=old;else $('level').value='';updateSubjects()}
function syncSubjects(){for(const [name,box]of subjectChecks)box.checked=selectedSubjects.has(name);if(allSubjectBox){allSubjectBox.checked=subjectChecks.size>0&&selectedSubjects.size===subjectChecks.size;allSubjectBox.indeterminate=selectedSubjects.size>0&&selectedSubjects.size<subjectChecks.size}updateSearch()}
function updateSubjects(){const target=$('subject-controls'),level=$('level').value;target.replaceChildren();subjectChecks.clear();allSubjectBox=null;if(!level){selectedSubjects.clear();target.append(el('p','Select a level to see its subjects.','help'));updateSearch();return}const levelData=data.filter(r=>levels(r).includes(level));const branchData=levelData.filter(r=>selectedBranches.has(r[1]));const options=[...new Set((branchData.length?branchData:levelData).flatMap(subjects))].filter(x=>x!=='Unspecified subject').sort();const prior=new Set(selectedSubjects);selectedSubjects.clear();for(const name of options)if(allSubjects||prior.has(name))selectedSubjects.add(name);const [all,box]=check('All subjects for this level',on=>{allSubjects=on;selectedSubjects.clear();if(on)options.forEach(name=>selectedSubjects.add(name));syncSubjects();pending()});allSubjectBox=box;all.className+=' all-choice';target.append(all);for(const name of options){const [row,subjectBox]=check(name,on=>{if(on)selectedSubjects.add(name);else selectedSubjects.delete(name);allSubjects=selectedSubjects.size===options.length;syncSubjects();pending()});subjectChecks.set(name,subjectBox);target.append(row)}syncSubjects()}
$('level').addEventListener('change',()=>{allSubjects=true;updateSubjects();pending()});
function el(tag,text,cls){const n=document.createElement(tag);if(text!=null)n.textContent=text;if(cls)n.className=cls;return n}
function contacts(b){const c=el('div',null,'contact');if(b[3]){const a=el('a',b[3]);a.href='tel:+65'+b[3];c.append(el('span','Phone: '),a)}else c.append(el('span','Phone number not supplied'));if(b[5]&&/^(https:\/\/|tel:)/.test(b[5])){c.append(el('br'));const a=el('a','Contact branch');a.href=b[5];a.target='_blank';a.rel='noopener';c.append(a)}return c}
function render(f){const selectedBranches=branches.filter(b=>f.branches.includes(b[0]));const filtered=data.filter(r=>selectedBranches.some(b=>b[0]===r[1])&&f.subjects.some(sub=>subjects(r).includes(sub))&&levels(r).includes(f.level));$('results').replaceChildren();let shown=0;
for(const b of selectedBranches){const rows=filtered.filter(r=>r[1]===b[0]),hasAny=data.some(r=>r[1]===b[0]);if(!rows.length&&hasAny)continue;shown++;const section=el('section',null,'panel');const header=el('div',null,'branch-head'),title=el('div');title.append(el('h2',b[1]),el('div',(b[2]||'Zone not assigned')+' · '+rows.length+' matching class times','muted'));header.append(title,contacts(b));section.append(header);
if(!hasAny){section.append(el('p','Class Schedule Not Available. Please contact us.','empty'));$('results').append(section);continue}
const timed=rows;
if(timed.length){const scroll=el('div',null,'scroll'),table=el('table',null,'week');table.setAttribute('aria-label',b[1]+' weekly class timetable');const head=el('thead'),hr=el('tr');for(const d of ['Level / Subject',...days]){const th=el('th',d);th.scope='col';hr.append(th)}head.append(hr);table.append(head);const body=el('tbody');const groups=new Map();for(const r of timed){const key=levels(r).join(', ')+' / '+subjectName(r[3]);if(!groups.has(key))groups.set(key,[]);groups.get(key).push(r)}for(const [name,entries] of [...groups].sort((a,b)=>a[0].localeCompare(b[0],undefined,{numeric:true}))){const tr=el('tr');const label=el('th',name);label.scope='row';tr.append(label);for(let day=1;day<=7;day++){const td=el('td');const dayEntries=entries.filter(r=>r[6]===day).sort((a,b)=>a[7]-b[7]||a[8]-b[8]);for(const r of dayEntries){const c=el('div',null,'class');c.append(el('strong',r[7]!=null&&r[8]!=null?clock(r[7])+'–'+clock(r[8]):'Please contact us'));if(r[9])c.append(el('small',r[9]));if(r[10]!=='unspecified')c.append(el('small',r[10]));td.append(c)}if(!dayEntries.length)td.append(el('span','—','muted'));tr.append(td)}body.append(tr)}table.append(body);scroll.append(table);section.append(scroll)}
$('results').append(section)}
if(!shown)$('results').append(el('p','No matching classes. Change your filters and click Search.','panel empty'));
$('count').textContent=filtered.length+' matching class times across '+shown+' branches';$('filter-help').textContent='Showing your search results. Change selections and click Search to update.'}
$('filters').addEventListener('submit',event=>{event.preventDefault();if(!selectedBranches.size||!$('level').value||!selectedSubjects.size)return;hasSearched=true;render({branches:[...selectedBranches],subjects:[...selectedSubjects],level:$('level').value})});
$('reset').addEventListener('click',()=>{selectedBranches.clear();selectedSubjects.clear();allSubjects=true;hasSearched=false;$('level').value='';syncBranchChecks();updateLevels();$('count').textContent='';$('results').replaceChildren(el('p','Select your branches, level and subjects, then click Search to view class schedules.','empty'));$('filter-help').textContent='Select at least one branch and one level.';updateSearch()});
buildBranches();updateLevels();if(typeof window!=='undefined'&&window.self!==window.top)document.body.classList.add('embedded');

SCHEDULEEDITOR
</script></body></html>
