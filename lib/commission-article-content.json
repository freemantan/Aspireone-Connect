{"html": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>Aspire Hub Commissions 2027 · v3</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\">\n<style>\n:root{--bg:#ffffff;--panel:#ffffff;--panel2:#f3f7f6;--ink:#1f2937;--ink2:#4b5563;--muted:#7b8794;--line:#dfe6e5;--accent:#1e6f73;--accent2:#389fa8;--accent-soft:#e3f1f0;--brand:#ffaf01;--brand-soft:#fff5dc;--good:#3c8a7c;--good-soft:#e6f3ef;--bad:#b75b57;--bad-soft:#f7e6e5;--shadow:0 1px 2px rgba(31,41,55,.05),0 4px 14px rgba(31,41,55,.05)}\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]){--bg:#141a1c;--panel:#1b2326;--panel2:#22302f;--ink:#e8edec;--ink2:#b8c3c1;--muted:#8a9794;--line:#2f3d3c;--accent:#7fd0cf;--accent2:#5bb9c0;--accent-soft:#1f3a3b;--brand:#ffbe3d;--brand-soft:#3a3117;--good:#6cc6b3;--good-soft:#1d3a34;--bad:#e08b87;--bad-soft:#3d2523;--shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35)}}\n:root[data-theme=\"dark\"]{--bg:#141a1c;--panel:#1b2326;--panel2:#22302f;--ink:#e8edec;--ink2:#b8c3c1;--muted:#8a9794;--line:#2f3d3c;--accent:#7fd0cf;--accent2:#5bb9c0;--accent-soft:#1f3a3b;--brand:#ffbe3d;--brand-soft:#3a3117;--good:#6cc6b3;--good-soft:#1d3a34;--bad:#e08b87;--bad-soft:#3d2523;--shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35)}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font-family:\"Inter\",system-ui,-apple-system,\"Segoe UI\",sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}\n.wrap{max-width:1120px;margin:0 auto;padding-inline:24px;padding-block:0 56px}\nh1,h2,h3{margin:0;letter-spacing:-.015em;text-wrap:balance}\nh1{font-size:clamp(26px,3.8vw,36px);font-weight:700;line-height:1.15}\nh2{font-size:22px;font-weight:700}\nh3{font-size:15px;font-weight:600;color:var(--accent);text-transform:uppercase;letter-spacing:.06em;margin:18px 0 8px}\np{margin:0 0 12px;max-width:80ch}\n.brand{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-block:28px 10px}\n.brand img{height:56px;width:auto;max-width:100%}\n.brand .tag{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600}\n.eyebrow{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700}\n.sub{color:var(--ink2);font-size:16px;max-width:76ch}\nnav.toc{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--panel) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);margin:0 -24px 24px;padding:10px 24px;display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}\nnav.toc a{white-space:nowrap;font-size:13px;font-weight:600;color:var(--ink2);text-decoration:none;padding:6px 10px;border-radius:8px}\nnav.toc a:hover,nav.toc a:focus-visible{background:var(--accent-soft);color:var(--accent);outline:none}\n.guide{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:18px 0 10px}\n.g{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--accent2);border-radius:10px;padding:14px 16px;box-shadow:var(--shadow)}\n.g:nth-child(2){border-top-color:var(--brand)}.g:nth-child(3){border-top-color:var(--good)}.g:nth-child(4){border-top-color:#9aa8b4}\n.g .k{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--muted)}\n.g .t{font-size:17px;font-weight:700;margin:4px 0 6px}\n.g p{font-size:14px;color:var(--ink2);margin:0}\n.g .big{font-size:26px;font-weight:700;color:var(--accent);margin:2px 0 4px;letter-spacing:-.02em}\nsection{padding-block:30px 6px;border-top:1px solid var(--line);margin-top:20px}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);margin:14px 0;overflow:hidden}\n.card .hd{padding:14px 18px;background:var(--accent-soft);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center}\n.card .hd .n{font-weight:700;font-size:17px}\n.card .hd .m{font-size:13px;color:var(--ink2)}\n.tw{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-size:15px;font-variant-numeric:tabular-nums}\nth,td{padding:10px 14px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}\nth:first-child,td:first-child{text-align:left;font-weight:600}\nth{font-size:11.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);font-weight:600;background:var(--panel2)}\nth small,td small{display:block;font-weight:400;font-size:11px;color:var(--muted);letter-spacing:0;text-transform:none}\ntr:last-child td{border-bottom:none}\ntd.hi{background:var(--brand-soft);font-weight:700}\ntd.ok{background:var(--good-soft);font-weight:700}\ntd.grp,th.grp{border-left:2px solid var(--line)}\ntd.dash{color:var(--muted)}\ntd.rem{white-space:normal;text-align:left;font-weight:400;font-size:13.5px;color:var(--ink2);min-width:260px}\ntr.band td{background:var(--panel2);font-weight:700;color:var(--accent);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;padding:7px 14px}\n.note{font-size:13.5px;color:var(--muted);padding:10px 18px 14px;border-top:1px solid var(--line);margin:0;max-width:none}\n.key{background:var(--brand-soft);border-left:4px solid var(--brand);border-radius:10px;padding:14px 18px;margin:14px 0;font-size:15px}\n.key b{color:var(--ink)}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 4px}\n.chip{background:var(--accent-soft);color:var(--accent);border-radius:999px;padding:3px 10px;font-size:12.5px;font-weight:600}\n.ctl{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:13.5px;color:var(--ink2)}\n.ctl label{font-weight:600;color:var(--ink)}\n.ctl input[type=range]{accent-color:var(--accent);width:160px}\n.ctl output{font-weight:700;color:var(--accent);min-width:38px;display:inline-block}\n.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--panel)}\n.seg button{border:0;background:transparent;color:var(--ink2);font:inherit;font-size:13px;font-weight:600;padding:5px 11px;cursor:pointer}\n.seg button[aria-pressed=true]{background:var(--accent);color:#fff}\n.seg button:focus-visible{outline:2px solid var(--accent2);outline-offset:-2px}\n.split{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px;margin:14px 0}\nfooter{color:var(--muted);font-size:13px;margin-top:36px;border-top:1px solid var(--line);padding-top:14px}\n@media print{nav.toc{display:none}.card{break-inside:avoid}.ctl{display:none}}\nselect,input[type=number]{font:inherit;border:1px solid var(--line);border-radius:7px;padding:7px;background:var(--panel);color:var(--ink)}\n.controls{display:flex;flex-wrap:wrap;gap:18px;padding:18px;background:var(--panel2);border-radius:12px;margin:18px 0}.controls label{display:grid;gap:5px;font-size:13px;font-weight:600}.controls input{width:95px}\nsection,.card[id]{scroll-margin-top:70px}thead th{color:var(--ink2)}td:first-child{white-space:normal;min-width:170px} .status{font-size:13px;color:var(--accent);margin:12px 0} @media(max-width:600px){.wrap{padding-inline:16px}.brand img{height:44px}.card .hd .n{font-size:19px}th,td{padding:10px}}\n.commission-toggle{min-height:38px;padding:8px 14px;border:1px solid #b8c3cc;border-radius:7px;background:#eef1f4;color:#394957;font-weight:650;cursor:pointer}.commission-toggle.is-on{background:#ffb84d;border-color:#eea437;color:#26343c}.commission-toggle:focus-visible{outline:3px solid #287d83;outline-offset:3px}.commission-option{display:grid;gap:5px;font-size:13px;font-weight:600}.commission-buttons{display:flex;gap:6px}.commission-buttons button{min-height:38px;padding:8px 14px;border:1px solid #b8c3cc;border-radius:7px;background:white;font-weight:600;cursor:pointer}.commission-buttons button[aria-pressed=true]{background:#ffb84d;border-color:#eea437;color:#26343c}.commission-buttons button:focus-visible{outline:3px solid #287d83;outline-offset:3px}#earn table{width:100%;min-width:0;table-layout:fixed;font-size:13px}\n#earn th,#earn td{min-width:0;padding:9px 5px;white-space:normal;overflow-wrap:anywhere;line-height:1.35}\n#earn th:first-child,#earn td:first-child{width:22%;min-width:0}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n<div class=\"brand\"><img src=\"data:image/png;base64,\" alt=\"Aspire Hub Education\"><div class=\"tag\">Commission structure · 2027</div></div>\n<nav class=\"toc\" aria-label=\"Sections\"><a href=\"#glance\">At a glance</a><a href=\"#table\">Commission table</a><a href=\"#earn\">Who earns what</a><a href=\"#pa\">Product A</a><a href=\"#pb\">Product B</a><a href=\"#pc\">Product C</a><a href=\"#pd\">Product D</a><a href=\"#notes\">Notes</a></nav>\n\n<div class=\"eyebrow\">Business Planning · database snapshot</div>\n<h1>Aspire Hub Sales Commissions, 2027</h1>\n<p class=\"sub\">The latest saved commission settings from AspireOne Connect, with allocations by sales channel and worked examples for all four products.</p>\n<p class=\"status\"><b>Published</b> · Effective 1 January 2027 · Last published 30 September 2026, 11:15:57 am (Singapore) · Checked 6 October 2026</p>\n<div class=\"key\"><b>How to read it.</b> Choose the sales channel and product. A confirmed <b>0%</b> means no commission; <b>Pending</b> means no rate has been set. Initial-sale rates are published. The subsequent-term comparison excludes one-time initial commissions; it does not change saved renewal or upsell allocation settings.</div>\n<section id=\"glance\" style=\"border-top:none;margin-top:0;padding-top:6px\"><h2>At a glance · initial sales</h2><div class=\"guide\">\n<div class=\"g\"><div class=\"k\">Physical centre · A / B</div><div class=\"big\">0%</div><p>All four commission allocations are confirmed zero.</p></div>\n<div class=\"g\"><div class=\"k\">Aspire Online · A / B</div><div class=\"big\">5%</div><p>Allocated to Aspire Online. This channel is listed for A and B only.</p></div>\n<div class=\"g\"><div class=\"k\">Product C · Physical Centre</div><div class=\"big\">15%</div><p>CRE receives 10% and Branch receives 5%. Cold Call uses a fixed CRE payout plus CRM 3% and Branch 2%.</p></div>\n<div class=\"g\"><div class=\"k\">Product D · centre / cold call</div><div class=\"big\">30%</div><p>CRE receives 20%. The remaining 10% is split according to channel.</p></div>\n<div class=\"g\"><div class=\"k\">Cold call · A / B</div><div class=\"big\">Fixed + 8%</div><p>CRE: S$150 / S$100 / S$0 per student by lesson count. CRM 3% + Aspire Online 5%.</p></div>\n<div class=\"g\"><div class=\"k\">Teacher shares · B and C</div><div class=\"big\">40%</div><p>Teacher share: A 50%, B 40%, C 40%, D 0%. Teacher cost is the higher of the percentage share and the minimum per lesson. The default minimum is S$90 for A/B/C and S$0 for D.</p></div></div>\n<div class=\"chips\"><span class=\"chip\">CRE · Customer Relations Executive</span><span class=\"chip\">CRM · Customer Relationship Manager</span><span class=\"chip\">Branch · physical centre</span><span class=\"chip\">Aspire Online · database recipient label</span></div></section>\n<section id=\"table\"><h2>1. Final commission allocations</h2><p>Initial sale. Cold Call CRE for A/B/C is a fixed amount per student: S$150 for 8+ lessons, S$100 for 4–7 lessons, S$0 below 4 lessons.</p><div class=\"card\"><div class=\"hd\">Physical Centre</div><div class=\"tw\"><table><thead><tr><th>Product</th><th>CRE</th><th>CRM</th><th>Branch</th><th>Aspire Online</th><th>Total</th></tr></thead><tbody><tr><td>A</td><td>0%</td><td>0%</td><td>0%</td><td>0%</td><td>0%</td></tr><tr><td>B</td><td>0%</td><td>0%</td><td>0%</td><td>0%</td><td>0%</td></tr><tr><td>C</td><td>10%</td><td>0%</td><td>5%</td><td>0%</td><td>15%</td></tr><tr><td>D</td><td>20%</td><td>0%</td><td>10%</td><td>0%</td><td>30%</td></tr></tbody></table></div></div><div class=\"card\"><div class=\"hd\">Aspire Online</div><div class=\"tw\"><table><thead><tr><th>Product</th><th>CRE</th><th>CRM</th><th>Branch</th><th>Aspire Online</th><th>Total</th></tr></thead><tbody><tr><td>A</td><td>0%</td><td>0%</td><td>0%</td><td>5%</td><td>5%</td></tr><tr><td>B</td><td>0%</td><td>0%</td><td>0%</td><td>5%</td><td>5%</td></tr></tbody></table></div></div><div class=\"card\"><div class=\"hd\">Cold Call</div><div class=\"tw\"><table><thead><tr><th>Product</th><th>CRE</th><th>CRM</th><th>Branch</th><th>Aspire Online</th><th>Total</th></tr></thead><tbody><tr><td>A</td><td>S$150 / S$100 / S$0</td><td>3%</td><td>0%</td><td>5%</td><td>Fixed CRE + 8%</td></tr><tr><td>B</td><td>S$150 / S$100 / S$0</td><td>3%</td><td>0%</td><td>5%</td><td>Fixed CRE + 8%</td></tr><tr><td>C</td><td>S$150 / S$100 / S$0</td><td>3%</td><td>2%</td><td>0%</td><td>Fixed CRE + 5%</td></tr><tr><td>D</td><td>20%</td><td>5%</td><td>5%</td><td>0%</td><td>30%</td></tr></tbody></table></div></div></section><section id=\"earn\"><h2>2. Who earns what</h2>\n<div class=\"controls\"><label>Sales Channel<select id=\"channel\"><option>Physical Centre</option><option>Aspire Online</option><option>Cold Call</option></select></label><label>Commission Basis<select id=\"basis\"><option value=\"gross\">Full fee</option><option value=\"net\">After teacher pay</option></select></label></div>\n<p class=\"note\" id=\"scenario\" aria-live=\"polite\"></p>\n<div class=\"card\" id=\"pa\"><div class=\"hd\"><span class=\"n\">Product A — Academic Coaching</span></div><div class=\"controls\"><label>Students<input aria-label=\"Product A students\" id=\"studentsA\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"1\"></label><label>Lessons/classes<input aria-label=\"Product A lessons/classes\" id=\"lessonsA\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"12\"></label><label>Teacher share (%)<input aria-label=\"Product A teacher share\" id=\"shareA\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value=\"50\"></label><label>Min. pay per lesson (S$)<input aria-label=\"Product A min. pay per lesson\" id=\"minA\" type=\"number\" min=\"0\" step=\"0.01\" value=\"90\"></label><div class=\"commission-option\"><span>Commission</span><div class=\"commission-buttons\" id=\"commissionsA\" role=\"group\" aria-label=\"Product A commission\"><button type=\"button\" data-include=\"true\" aria-pressed=\"true\">Include</button><button type=\"button\" data-include=\"false\" aria-pressed=\"false\">Exclude</button></div></div></div><div class=\"tw\"><table id=\"ta\"></table></div><p class=\"note\">Both retain figures deduct Teacher Cost, Royalty Fee (7% of Fee) and Reward Program (2% of Fee). First Term Retain also deducts one-time CRE, CRM, Branch and Aspire Online commissions. Teacher Cost uses the higher of teacher share and minimum pay.</p></div><div class=\"card\" id=\"pb\"><div class=\"hd\"><span class=\"n\">Product B — Physical Tutorial</span></div><div class=\"controls\"><label>Students<input aria-label=\"Product B students\" id=\"studentsB\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"1\"></label><label>Lessons/classes<input aria-label=\"Product B lessons/classes\" id=\"lessonsB\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"12\"></label><label>Teacher share (%)<input aria-label=\"Product B teacher share\" id=\"shareB\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value=\"40\"></label><label>Min. pay per lesson (S$)<input aria-label=\"Product B min. pay per lesson\" id=\"minB\" type=\"number\" min=\"0\" step=\"0.01\" value=\"90\"></label><div class=\"commission-option\"><span>Commission</span><div class=\"commission-buttons\" id=\"commissionsB\" role=\"group\" aria-label=\"Product B commission\"><button type=\"button\" data-include=\"true\" aria-pressed=\"true\">Include</button><button type=\"button\" data-include=\"false\" aria-pressed=\"false\">Exclude</button></div></div></div><div class=\"tw\"><table id=\"tb\"></table></div><p class=\"note\">Both retain figures deduct Teacher Cost, Royalty Fee (7% of Fee) and Reward Program (2% of Fee). First Term Retain also deducts one-time CRE, CRM, Branch and Aspire Online commissions. Teacher Cost uses the higher of teacher share and minimum pay.</p><p class=\"note\">Package rate. The selected lesson count multiplies the published per-lesson / per-class rate.</p></div><div class=\"card\" id=\"pc\"><div class=\"hd\"><span class=\"n\">Product C — Online Live Tutorial</span></div><div class=\"controls\"><label>Students<input aria-label=\"Product C students\" id=\"studentsC\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"1\"></label><label>Lessons/classes<input aria-label=\"Product C lessons/classes\" id=\"lessonsC\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"12\"></label><label>Teacher share (%)<input aria-label=\"Product C teacher share\" id=\"shareC\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value=\"40\"></label><label>Min. pay per lesson (S$)<input aria-label=\"Product C min. pay per lesson\" id=\"minC\" type=\"number\" min=\"0\" step=\"0.01\" value=\"90\"></label><div class=\"commission-option\"><span>Commission</span><div class=\"commission-buttons\" id=\"commissionsC\" role=\"group\" aria-label=\"Product C commission\"><button type=\"button\" data-include=\"true\" aria-pressed=\"true\">Include</button><button type=\"button\" data-include=\"false\" aria-pressed=\"false\">Exclude</button></div></div></div><div class=\"tw\"><table id=\"tc\"></table></div><p class=\"note\">Both retain figures deduct Teacher Cost, Royalty Fee (7% of Fee) and Reward Program (2% of Fee). First Term Retain also deducts one-time CRE, CRM, Branch and Aspire Online commissions. Teacher Cost uses the higher of teacher share and minimum pay.</p><p class=\"note\">12-class rate. The selected lesson count multiplies the published per-lesson / per-class rate.</p></div><div class=\"card\" id=\"pd\"><div class=\"hd\"><span class=\"n\">Product D — E-Learning</span></div><div class=\"controls\"><label>Students<input aria-label=\"Product D students\" id=\"studentsD\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"1\"></label><label>Lessons/classes<input aria-label=\"Product D lessons/classes\" id=\"lessonsD\" type=\"number\" min=\"1\" max=\"1000\" step=\"1\" value=\"12\"></label><label>Teacher share (%)<input aria-label=\"Product D teacher share\" id=\"shareD\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value=\"0\"></label><label>Min. pay per lesson (S$)<input aria-label=\"Product D min. pay per lesson\" id=\"minD\" type=\"number\" min=\"0\" step=\"0.01\" value=\"0\"></label><div class=\"commission-option\"><span>Commission</span><div class=\"commission-buttons\" id=\"commissionsD\" role=\"group\" aria-label=\"Product D commission\"><button type=\"button\" data-include=\"true\" aria-pressed=\"true\">Include</button><button type=\"button\" data-include=\"false\" aria-pressed=\"false\">Exclude</button></div></div></div><div class=\"tw\"><table id=\"td\"></table></div><p class=\"note\">Both retain figures deduct Teacher Cost, Royalty Fee (7% of Fee) and Reward Program (2% of Fee). First Term Retain also deducts one-time CRE, CRM, Branch and Aspire Online commissions. Teacher Cost uses the higher of teacher share and minimum pay.</p></div></section><section id=\"notes\"><h2>Notes and source</h2>\n<p>Source: exported current Business Planning commission settings, with teacher shares confirmed by Freeman: A 50%, B 40%, C 40%, D 0%. Prices use the supplied published price export. This is a snapshot, not a live database link.</p><p>Both retain figures deduct Teacher Cost, Royalty Fee (7% of Fee) and Reward Program (2% of Fee). First Term Retain also deducts one-time CRE, CRM, Branch and Aspire Online commissions. Teacher Cost uses the higher of teacher share and minimum pay. Percentage commissions are rounded to the nearest dollar, matching Business Planning.</p><p>Cold Call CRE for A/B/C is per student: S$150 for 8+ lessons, S$100 for 4–7 lessons, and S$0 below 4 lessons. Product D uses its percentage rate. The subsequent-term comparison excludes one-time initial commissions; it does not change saved renewal or upsell allocation settings.</p>\n<p>Product C JC examples use the approved 12-class fees of S$810.00 (C only) and S$712.80 (existing package student). Other worked-example prices use the database’s published price snapshot (26 September 2026, 3:36:46 pm), matching the live commission calculator. This is a different source from the later locally revised price-list article. Fees are shown in SGD without any additional GST calculation or registration charge.</p>\n<p>Aspire Online is the current recipient name in the database, replacing the old article’s AHG column. The Aspire Online sales channel is defined for A/B only. Pending allocations and channels not listed are never treated as confirmed zero.</p>\n<p>Snapshot updated 8 November 2026. Scenario changes are temporary and do not save to Business Planning.</p></section><footer>Version 4 · Updated 8 November 2026 · Effective 1 January 2027</footer></div><script>\n(function(){\nconst rates={\"Aspire Online\": {\"A\": [0, 0, 0, 5], \"B\": [0, 0, 0, 5]}, \"Cold Call\": {\"A\": [15, 3, 0, 5], \"B\": [15, 3, 0, 5], \"C\": [10, 3, 2, 0], \"D\": [20, 5, 5, 0]}, \"Physical Centre\": {\"A\": [0, 0, 0, 0], \"B\": [0, 0, 0, 0], \"C\": [10, 0, 5, 0], \"D\": [20, 0, 10, 0]}},prices={\"A\": [[\"Primary 1\\u20132\", \"Academic coaching\", 77.0], [\"Primary 3\\u20134\", \"Academic coaching\", 77.0], [\"Primary 5\\u20136\", \"Academic coaching\", 87.0], [\"Secondary 1\\u20132 / IP\\u00b7IB Y1\\u20132\", \"Academic coaching\", 97.0], [\"Secondary 3\\u20135\", \"Academic coaching\", 102.0], [\"IB / IP Y3\\u2013Y4\", \"Academic coaching\", 112.0], [\"JC / IB / IP Y5\\u2013Y6\", \"Academic coaching\", 125.0]], \"B\": [[\"Primary 1\\u20132\", \"Physical tutorial\", 61.0], [\"Primary 3\\u20134\", \"Physical tutorial\", 61.0], [\"Primary 5\\u20136\", \"Physical tutorial\", 69.0], [\"Secondary 1\\u20132 / IP\\u00b7IB Y1\\u20132\", \"Physical tutorial\", 78.0], [\"Secondary 3\\u20135\", \"Physical tutorial\", 81.0], [\"IB / IP Y3\\u2013Y4\", \"Physical tutorial\", 91.0], [\"JC / IB / IP Y5\\u2013Y6\", \"Physical tutorial\", 99.0]], \"C\": [[\"Primary 3\\u20134\", \"C only\", 36.0], [\"Primary 5\\u20136\", \"C only\", 43.2], [\"Secondary 1\\u20132\", \"C only\", 43.2], [\"Secondary 3\\u20134\", \"C only\", 45.9], [\"Primary 3\\u20134\", \"Existing package student\", 30.6], [\"Primary 5\\u20136\", \"Existing package student\", 36.0], [\"Secondary 1\\u20132\", \"Existing package student\", 36.0], [\"Secondary 3\\u20134\", \"Existing package student\", 38.7], [\"JC\", \"C only\", 67.5], [\"JC\", \"Existing package student\", 59.4]], \"D\": [[\"Primary 1\\u20132\", \"Standard\", 355.0], [\"Primary 3\\u20136\", \"Standard\", 481.0], [\"Secondary 1\\u20134\", \"Standard\", 607.0], [\"Primary 1\\u20132\", \"Aspire Hub student\", 284.0], [\"Primary 3\\u20136\", \"Aspire Hub student\", 385.0], [\"Secondary 1\\u20134\", \"Aspire Hub student\", 486.0]]};\nconst $=id=>document.getElementById(id), money=v=>v===null?'Pending':'S$'+(v/100).toLocaleString('en-SG',{minimumFractionDigits:2,maximumFractionDigits:2});\nfunction render(){\n const channel=$('channel').value,basis=$('basis').value;\n $('scenario').textContent='First term and subsequent terms · '+channel+' · '+(basis==='gross'?'Full fee':'After teacher pay');\n for(const p of ['A','B','C','D']){\n const students=Math.max(1,Math.min(1000,Math.floor(Number($('students'+p).value)||1))),lessons=Math.max(1,Math.min(1000,Math.floor(Number($('lessons'+p).value)||1)));\n const hasTeacher=true,share=Math.max(0,Math.min(100,Number($('share'+p).value)||0)),minimum=Math.round(Math.max(0,Number($('min'+p).value)||0)*100),r=rates[channel][p];\n let h='<thead><tr><th>Level / category</th><th>Fee</th><th>Teacher Cost</th><th>CRE</th><th>CRM</th><th>Branch</th><th>AOE</th><th>First Term Retain</th><th>Subsequent Retain</th></tr></thead><tbody>';\n const includeCommissions=$('commissions'+p).querySelector('[data-include=\"true\"]').getAttribute('aria-pressed')==='true';\n if(!r&&includeCommissions){$('t'+p.toLowerCase()).innerHTML='<tbody><tr><td>Aspire Online channel is not listed for Product '+p+' in the database.</td></tr></tbody>';continue;}\n for(const row of prices[p]){\n const fee=Math.round(row[2]*100)*students*(p==='D'?1:lessons),teacher=hasTeacher?Math.max(minimum*lessons,Math.round(fee*share/100)):0,base=basis==='gross'?fee:fee-teacher;\n const payouts=includeCommissions?r.map(v=>Math.round(base*v/10000)*100):[0,0,0,0];\n if(includeCommissions&&channel==='Cold Call'&&p!=='D')payouts[0]=students*(lessons>=8?15000:lessons>=4?10000:0);\n const franchise=Math.round(fee*.07),reward=Math.round(fee*.02),regular=teacher+franchise+reward,grossProfit=fee-regular,promotion=payouts.some(v=>v===null)?null:payouts.reduce((a,b)=>a+b,0),retained=promotion===null?null:grossProfit-promotion;\n h+='<tr><td>'+row[0]+'<small>'+row[1]+'</small></td><td class=\"hi\">'+money(fee)+'</td><td>'+money(teacher)+'</td>'+payouts.map(v=>'<td>'+money(v)+'</td>').join('')+'<td class=\"hi\">'+money(retained)+'</td><td class=\"hi\">'+money(grossProfit)+'</td></tr>';\n }\n $('t'+p.toLowerCase()).innerHTML=h+'</tbody>';\n }\n}\ndocument.querySelectorAll('.commission-buttons button').forEach(button=>button.addEventListener('click',()=>{button.parentElement.querySelectorAll('button').forEach(option=>option.setAttribute('aria-pressed',String(option===button)));render();}));\ndocument.querySelectorAll('select,input').forEach(e=>e.addEventListener('input',render));render();\n})();\n</script></body></html>"}
